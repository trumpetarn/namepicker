{
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "npm": "please-use-pnpm"
  },
  "scripts": {
    "serve": "python3 -m http.server 8000",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig/app.json && tsc -p tsconfig/sw.json",
    "test": "node --test \"tests/*.test.js\"",
    "check": "pnpm lint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-plugin-html": "^8.2.1",
    "globals": "^17.13.0",
    "typescript": "^7.0.2"
  }
}
